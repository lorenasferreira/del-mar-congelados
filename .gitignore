# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Builds
dist/
build/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Java
target/
*.class

# Maven
.mvn/timing.properties

# IntelliJ
*.iml

# Local databases
*.db
*.sqlite
EOF